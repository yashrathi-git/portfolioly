# ============================================
# CORS & Frontend Configuration
# ============================================
# Comma-separated list of additional allowed origins for CORS
# Default origins (always included): http://localhost:3000, https://portfolioly.app, https://www.portfolioly.app
# Use "*" to allow all origins
# Examples:
#   Additional origins: https://yourdomain.com,https://www.yourdomain.com
#   Allow all: *
ALLOWED_ORIGINS_STR=

# Main frontend URL (optional, will be added to allowed_origins automatically)
FRONTEND_ORIGIN=http://localhost:3000

# ============================================
# Firebase Configuration
# ============================================
GOOGLE_APPLICATION_CREDENTIALS="/path/to/your/firebaseServiceKey.json"
FIREBASE_PROJECT_ID=your-firebase-project-id

# Require email verification for authenticated routes
REQUIRE_EMAIL_VERIFICATION=true

# ============================================
# Security Configuration
# ============================================
# REQUIRED: Global secret for public token generation
# Must be at least 32 characters long
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GLOBAL_SECRET=your-secret-key-here-min-32-chars-required

# ============================================
# AI Configuration
# ============================================
# Azure AI Configuration
AZURE_AI_API_KEY=your_azure_ai_api_key_here
AZURE_AI_ENDPOINT=https://your-resource.services.ai.azure.com/models
AZURE_AI_PROCESSOR_MODEL=gpt-4o

# Google Gemini Configuration (alternative to Azure AI)
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Azure Blob Storage Configuration
# ============================================
# Enable/disable Azure Storage (set to false to use local storage for development)
ENABLE_AZURE_STORAGE=true

# Option 1: Connection string (recommended)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccountname;AccountKey=yourkey;EndpointSuffix=core.windows.net

# Option 2: Account URL + Key (alternative to connection string)
# AZURE_STORAGE_ACCOUNT_URL=https://youraccountname.blob.core.windows.net
# AZURE_STORAGE_ACCOUNT_KEY=your_account_key_here

# ============================================
# GitHub API Configuration
# ============================================
# Optional - for higher rate limits when fetching GitHub repos
GITHUB_API_TOKEN=your_github_token_here

# ============================================
# Brandfetch Configuration
# ============================================
# Enable logo enrichment via Brandfetch API
BRANDFETCH_ENABLED=false
BRANDFETCH_CLIENT_ID=your_brandfetch_client_id

# ============================================
# Rate Limiting Configuration
# ============================================
ENVIRONMENT=development

# Upstash Redis (for production rate limiting)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Rate limit overrides (optional)
# RATE_LIMIT_PDF_UPLOADS_PER_HOUR=10
# RATE_LIMIT_GITHUB_REQUESTS_PER_HOUR=10
# RATE_LIMIT_STORAGE_BACKEND=memory

# ============================================
# Upload Configuration (optional overrides)
# ============================================
# MAX_FILE_SIZE_MB=1.5
# MAX_IMAGE_SIZE_BYTES=5242880
# MAX_PROJECT_IMAGES=5
# MAX_GITHUB_REPOS=10

# ============================================
# Turnstile Configuration (optional)
# ============================================
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key