# Firebase Configuration
GOOGLE_APPLICATION_CREDENTIALS="/path/to/your/firebaseServiceKey.json"

# GitHub API Configuration (optional - for higher rate limits)
GITHUB_API_TOKEN=your_github_token_here

# Azure AI Configuration
AZURE_AI_API_KEY=your_azure_ai_api_key_here
AZURE_AI_ENDPOINT=https://your-resource.services.ai.azure.com/models

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Turnstile Configuration (optional)
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Security Configuration
# REQUIRED: Global secret for public token generation
# Must be at least 32 characters long
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GLOBAL_SECRET=your-secret-key-here-min-32-chars-required
