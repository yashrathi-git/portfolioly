# NOTE: This file is only used if building with backend/ as the build context.
# Currently, backend builds from monorepo root, so root .dockerignore is used.

# Environment files - NEVER include in Docker builds
.env
.env.*
*.env

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
.venv
venv
ENV

# Testing
.pytest_cache
.coverage
htmlcov
tests

# IDE
.vscode
.idea

# Git
.git
.gitignore

# Misc
*.log
.DS_Store

# Firebase credentials - mount at runtime, never bake in
firebaseServiceKeyJson
