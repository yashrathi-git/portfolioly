**/.hypothesis

# Environment files and logs
.env
.env.*
*.env
*.env.*
*.log

# Backend-specific secrets & junk
backend/firebaseServiceKeyJson/
backend/.env
backend/.venv
backend/.pytest_cache
backend/.mypy_cache
backend/.ruff_cache
backend/.coverage

# IDE / tooling
**/.idea
**/.vscode

