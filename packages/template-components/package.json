{
  "name": "portfolioly-template-components",
  "version": "0.3.0",
  "description": "Reusable portfolio components for Portfolioly templates",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.cjs",
      "types": "./dist/types/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/template-config.mjs",
      "require": "./dist/config/template-config.cjs",
      "types": "./dist/config/template-config.d.ts"
    },
    "./providers": {
      "import": "./dist/providers/index.mjs",
      "require": "./dist/providers/index.cjs",
      "types": "./dist/providers/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.cjs",
      "types": "./dist/utils/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "style": "dist/style.css",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yashrathi-git/portfolioly.git",
    "directory": "packages/template-components"
  },
  "keywords": [
    "portfolio",
    "react",
    "components",
    "nextjs",
    "template"
  ],
  "peerDependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.544.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@ai-sdk/react": "^1.0.26",
    "@icons-pack/react-simple-icons": "^13.8.0",
    "ai": "^4.1.8",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "markdown-to-jsx": "^7.7.14",
    "portfolioly-schema": "^0.3.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react-swc": "^3",
    "typescript": "^5",
    "vite": "^5",
    "vite-plugin-dts": "^4"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch"
  }
}
